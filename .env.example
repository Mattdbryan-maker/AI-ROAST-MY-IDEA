# All AI configuration is server-side. Copy to .env.local and fill in what you need.

# ─── Which panel ────────────────────────────────────────────────────────────
# demo | anthropic | ollama
# Unset: anthropic if ANTHROPIC_API_KEY is set, otherwise the offline demo panel.
# An explicit choice that can't work (e.g. anthropic without a key) is an error:
# the app never silently swaps in the demo.
AI_PROVIDER=

# Debate: "single" (default; one generation writes the whole roast) or
# "multi" (experimental; one extra call per debate line, each speaker replying to the last).
DEBATE_MODE=single

# ─── Claude (Anthropic API) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Default and release-candidate model: claude-haiku-5-5 (~$0.002 per roast + FIX). Stronger models
# (claude-sonnet-5-5, claude-opus-5-5) cost 20-40x more and are an explicit opt-in. See docs/models-and-costs.md.
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional: a different model for FIX MY IDEA (defaults to ANTHROPIC_MODEL).
ANTHROPIC_FIX_MODEL=
# low | medium | high | xhigh | max. Default low: short creative output, live audience.
ANTHROPIC_EFFORT=low
# Set to "false" to disable server-side refusal fallbacks (e.g. behind a gateway that rejects the field).
ANTHROPIC_SERVER_FALLBACK=true

# ─── Local Qwen via Ollama ──────────────────────────────────────────────────
# See docs/ollama-windows.md. Accepts host:port, a URL, or 0.0.0.0 (treated as 127.0.0.1).
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# Optional: a different model for FIX MY IDEA (defaults to OLLAMA_MODEL).
OLLAMA_FIX_MODEL=
# Reasoning: false (default) | true | low | medium | high. Reasoning is never shown on stage.
OLLAMA_THINK=false
# Context window. A roast needs ~5,000 tokens; 8192 leaves headroom.
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.7
# How long Ollama keeps the model in memory between roasts.
OLLAMA_KEEP_ALIVE=30m
# Give up if the first token takes longer (covers loading the model), or if the stream stalls.
OLLAMA_FIRST_TOKEN_TIMEOUT_MS=120000
OLLAMA_IDLE_TIMEOUT_MS=45000

# ─── Demo panel ─────────────────────────────────────────────────────────────
# Streaming speed in characters per second (roughly a fast model). 0 = instant.
DEMO_STREAM_CPS=450

# ─── App ────────────────────────────────────────────────────────────────────
# Public URL, used for share links in OG metadata and on share cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Requests per client per 10 minutes across /api/roast and /api/fix (in-memory, per instance).
RATE_LIMIT_PER_10_MIN=20

# Which header holds the real client address. Set it to the header your hosting edge overwrites on every
# request (Vercel: x-vercel-forwarded-for, Cloudflare: cf-connecting-ip, Fly: fly-client-ip). Unset in
# production, the LAST x-forwarded-for entry is used, which is only safe behind exactly one proxy.
CLIENT_IP_HEADER=

# Estimated API spend per UTC day for this instance, in USD (tokens x price table; not an account cap).
# Default in production on the Anthropic provider: 5. 0 = off.
DAILY_SPEND_LIMIT_USD=

# Generations running at once on this instance (each holds a slot until its stream ends). Default 8.
MAX_CONCURRENT_AI=8

# Ceiling on ALL AI requests per day for this instance (in-memory; resets on restart).
# Default in production on the Anthropic provider: 1000. Otherwise 0 = off.
# Per-IP limits can't bound spend on their own: set this for any public deployment with a paid
# provider, and also set a hard spend limit in the Anthropic console.
DAILY_AI_REQUEST_LIMIT=

# Show the technical reason behind AI errors on the error screen in production builds
# (always shown in development). Leave off for public deployments.
SHOW_AI_ERRORS=false

# ─── Production / protected beta (Vercel) ──────────────────────────────────────
# Full walkthrough: docs/phase-10-production-launch-readiness.md. In production with AI_PROVIDER=anthropic the
# app REFUSES to run paid requests unless the shared limiter below is configured (it fails closed, never open).
#
# Required in production:
#   AI_PROVIDER=anthropic            (production will not guess; unset = a clear configuration error)
#   ANTHROPIC_API_KEY=...            (a dedicated key, in its own Anthropic workspace with a spend limit)
#   ANTHROPIC_MODEL=claude-haiku-5-5 (production refuses any model not in the allow-list below)
# Optional: ANTHROPIC_ALLOWED_MODELS=claude-haiku-5-5   Widen only on purpose; stronger models cost 20-40x more.

# Shared rate limiter / spend counters: Upstash Redis (REST). The Vercel Marketplace integration sets the
# KV_REST_API_* names; a database created directly at Upstash gives the UPSTASH_REDIS_REST_* names. Either works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Beta policy (defaults shown; sized for ~10-20 invited testers). One "journey" = 1 roast + 1 FIX MY IDEA.
# Roasts and FIX runs are counted separately per visitor, per UTC day. 0 = that limit is off.
# VISITOR_DAILY_ROASTS=3
# VISITOR_DAILY_FIXES=3
# RATE_LIMIT_PER_10_MIN=10        requests per visitor per 10 minutes (rejected attempts count)
# DAILY_AI_REQUEST_LIMIT=150      all visitors, per UTC day
# DAILY_SPEND_LIMIT_USD=2         RESERVED dollars per UTC day (see RESERVE_PER_REQUEST_USD)
# MONTHLY_SPEND_LIMIT_USD=20      RESERVED dollars per UTC month. Keep the Anthropic console limit a little higher.
# RESERVE_PER_REQUEST_USD=0.01    flat price reserved per admitted request (measured cost is ~0.001)
# MAX_CONCURRENT_AI=4             generations at once across ALL instances

# Invite gate for the protected beta. Comma-separated codes (long and random, 16+ characters). Unset = no gate.
BETA_ACCESS_CODES=
# Signs the invite cookie and the human-check pass. 32+ random characters; required when either feature is on.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ACCESS_SIGNING_SECRET=

# Cloudflare Turnstile human check (recommended before a public launch). Both unset = off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Operator-only usage dashboard: GET /api/admin/stats with "Authorization: Bearer <token>". 24+ characters. Unset = route is off.
ADMIN_STATS_TOKEN=

# Shown on /privacy, /terms and /contact. Never invented: until set, those pages say so.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# Escape hatch for a single-process self-hosted deployment ONLY: allows the paid provider without the shared
# limiter. Limits are then per instance and do NOT bound spend across serverless instances. Leave unset on Vercel.
# ALLOW_INSTANCE_LOCAL_LIMITS=true
