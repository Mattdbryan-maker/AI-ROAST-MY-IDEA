# All AI configuration is server-side. Copy to .env.local and fill in what you need.

# ─── Which panel ────────────────────────────────────────────────────────────
# demo | anthropic | ollama
# Unset: anthropic if ANTHROPIC_API_KEY is set, otherwise the offline demo panel.
# An explicit choice that can't work (e.g. anthropic without a key) is an error:
# the app never silently swaps in the demo.
AI_PROVIDER=

# Debate: "single" (default; one generation writes the whole roast) or
# "multi" (experimental; one extra call per debate line, each speaker replying to the last).
DEBATE_MODE=single

# ─── Claude (Anthropic API) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Default claude-opus-5-5. Cheaper candidates to benchmark: claude-sonnet-5-5, claude-haiku-5-5.
# See docs/models-and-costs.md.
ANTHROPIC_MODEL=claude-opus-5-5
# Optional: a different model for FIX MY IDEA (defaults to ANTHROPIC_MODEL).
ANTHROPIC_FIX_MODEL=
# low | medium | high | xhigh | max. Default low: short creative output, live audience.
ANTHROPIC_EFFORT=low
# Set to "false" to disable server-side refusal fallbacks (e.g. behind a gateway that rejects the field).
ANTHROPIC_SERVER_FALLBACK=true

# ─── Local Qwen via Ollama ──────────────────────────────────────────────────
# See docs/ollama-windows.md. Accepts host:port, a URL, or 0.0.0.0 (treated as 127.0.0.1).
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# Optional: a different model for FIX MY IDEA (defaults to OLLAMA_MODEL).
OLLAMA_FIX_MODEL=
# Reasoning: false (default) | true | low | medium | high. Reasoning is never shown on stage.
OLLAMA_THINK=false
# Context window. A roast needs ~5,000 tokens; 8192 leaves headroom.
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.7
# How long Ollama keeps the model in memory between roasts.
OLLAMA_KEEP_ALIVE=30m
# Give up if the first token takes longer (covers loading the model), or if the stream stalls.
OLLAMA_FIRST_TOKEN_TIMEOUT_MS=120000
OLLAMA_IDLE_TIMEOUT_MS=45000

# ─── Demo panel ─────────────────────────────────────────────────────────────
# Streaming speed in characters per second (roughly a fast model). 0 = instant.
DEMO_STREAM_CPS=450

# ─── App ────────────────────────────────────────────────────────────────────
# Public URL, used for share links in OG metadata and on share cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Requests per IP per 10 minutes across /api/roast and /api/fix (in-memory, per instance).
RATE_LIMIT_PER_10_MIN=20

# Show the technical reason behind AI errors on the error screen in production builds
# (always shown in development). Leave off for public deployments.
SHOW_AI_ERRORS=false
