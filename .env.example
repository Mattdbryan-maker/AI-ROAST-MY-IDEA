# ─── AI provider ────────────────────────────────────────────────────────────
# Leave ANTHROPIC_API_KEY empty to run the offline demo panel (no network, no cost).
# With a key set, the live Claude panel is used automatically.
ANTHROPIC_API_KEY=

# Optional: force a provider ("anthropic" | "demo"). Default: anthropic if a key is set, else demo.
AI_PROVIDER=

# Optional: model and effort. Defaults: claude-opus-5-5, effort "low" (fast enough for a live show).
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# Optional: set to "false" to disable server-side refusal fallbacks (e.g. behind a gateway that rejects the field).
ANTHROPIC_SERVER_FALLBACK=true

# ─── App ────────────────────────────────────────────────────────────────────
# Public URL, used for share links in OG metadata and on share cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Requests per IP per 10 minutes across /api/roast and /api/fix (in-memory, per instance).
RATE_LIMIT_PER_10_MIN=20
